# Copy this file to .env and fill in your own values.
# Same CDP credentials used elsewhere in this repo -- see
# packages/resource-server/.env.example.

CDP_API_KEY_ID=your-api-key-id
CDP_API_KEY_SECRET=your-api-key-secret
CDP_WALLET_SECRET=your-wallet-secret

# "development" = Base Sepolia testnet (deploy here first, free)
# "production"  = Base mainnet (real ETH gas, flip only when ready)
X402_ENVIRONMENT=development

# Named CDP account used to sign the deployment transaction. Dedicated
# to this purpose so it's separate from any provider/payment wallet.
DEPLOYER_ACCOUNT_NAME=x402-contract-deployer
