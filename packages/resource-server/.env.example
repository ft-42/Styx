# Copy this file to .env and fill in your own values.
# Get CDP_API_KEY_ID / CDP_API_KEY_SECRET / CDP_WALLET_SECRET from:
# https://portal.cdp.coinbase.com  (Coinbase Developer Platform)

CDP_API_KEY_ID=your-api-key-id
CDP_API_KEY_SECRET=your-api-key-secret
CDP_WALLET_SECRET=your-wallet-secret

PORT=4001
PROVIDER_NAME=Price Feed A
ASSET=ETH
PRICE=$0.01

# "development" = Base Sepolia testnet (free test funds, use this first)
# "production"  = Base mainnet (real USDC, flip only when ready to go live)
X402_ENVIRONMENT=development

REGISTRY_URL=http://localhost:4000

# Optional: deployed ProviderRegistry contract address (see
# packages/contracts). Leave unset to skip on-chain registration --
# off-chain registry behavior is unaffected either way.
PROVIDER_REGISTRY_ADDRESS=
